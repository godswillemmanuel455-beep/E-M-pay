# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLW_SECRET_KEY: Flutterwave Secret Key (server-side only) for live Nigerian bank list
# and bank account name enquiry (https://api.flutterwave.com/v3/accounts/resolve).
# Configure this in your Secrets / environment variables; never expose it in client code.
FLW_SECRET_KEY="MY_FLUTTERWAVE_SECRET_KEY"

# FLW_WEBHOOK_HASH: Flutterwave Webhook Secret Hash (server-side only).
# Must match the Secret Hash configured in Flutterwave Dashboard > Settings > Webhooks.
FLW_WEBHOOK_HASH="MY_FLUTTERWAVE_WEBHOOK_HASH"

# Real Nigerian BVN & NIN KYC Verification Providers (configure one):
# 1. Youverify (supports both BVN & NIN): https://youverify.co
YOUVERIFY_API_KEY="MY_YOUVERIFY_API_KEY"
YOUVERIFY_SANDBOX="false"

# 2. QoreID (supports both BVN & NIN): https://qoreid.com
QOREID_CLIENT_ID="MY_QOREID_CLIENT_ID"
QOREID_SECRET_KEY="MY_QOREID_SECRET_KEY"

# 3. Mono Lookup (NIN lookup): https://mono.co
MONO_SECRET_KEY="MY_MONO_SECRET_KEY"

# Firebase Phone Auth (SMS OTP) Web Config (configure in Settings -> Secrets)
VITE_PHONE_FIREBASE_API_KEY="MY_FIREBASE_WEB_API_KEY"
VITE_PHONE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_PHONE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_PHONE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_PHONE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_PHONE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
